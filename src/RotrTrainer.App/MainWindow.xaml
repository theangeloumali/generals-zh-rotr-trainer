<Window x:Class="RotrTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command and Conquer Zero Hour RoTR Trainer"
        Width="440" SizeToContent="Height" ResizeMode="CanMinimize" WindowStyle="None"
        ShowActivated="False" Background="#0C1117" Foreground="#ECE7DE"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- ZKidz Dev screen theme (assets/brand/BRAND.md). Gold lands once: the armed state. -->
        <SolidColorBrush x:Key="Ground" Color="#0C1117" />
        <SolidColorBrush x:Key="Raised" Color="#121922" />
        <SolidColorBrush x:Key="Rule" Color="#243140" />
        <SolidColorBrush x:Key="RuleStrong" Color="#6F8AA6" />
        <SolidColorBrush x:Key="Copy" Color="#ECE7DE" />
        <SolidColorBrush x:Key="Quiet" Color="#95A3B3" />
        <SolidColorBrush x:Key="Dim" Color="#8494A5" />
        <SolidColorBrush x:Key="Steel" Color="#8EA9C4" />
        <SolidColorBrush x:Key="SteelStrong" Color="#B3C7DA" />
        <SolidColorBrush x:Key="SteelWash" Color="#298EA9C4" />
        <SolidColorBrush x:Key="Gold" Color="#D5B13A" />
        <FontFamily x:Key="Body">pack://application:,,,/Assets/Fonts/#Archivo</FontFamily>
        <!-- WPF folds the condensed cut into the Archivo family; FontStretch selects it -->
        <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Archivo</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Quiet}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Raised}" />
                    <Setter Property="Foreground" Value="{StaticResource Copy}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ArmButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0,10,0" />
            <Setter Property="Foreground" Value="{StaticResource Copy}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1.5" CornerRadius="6"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource SteelWash}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" BorderThickness="1.5"
                                Background="{StaticResource Raised}" BorderBrush="{StaticResource Rule}">
                            <!-- The knob is the ring node from the ZKidz mark -->
                            <Ellipse x:Name="Knob" Width="16" Height="16" StrokeThickness="4.5" Stroke="{StaticResource Dim}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SteelWash}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Steel}" />
                                <Setter TargetName="Knob" Property="Stroke" Value="{StaticResource SteelStrong}" />
                                <Setter TargetName="Knob" Property="Margin" Value="22,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Rule}" BorderThickness="1">
        <StackPanel TextElement.FontFamily="{StaticResource Body}">
            <!-- Title bar -->
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Height="36">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Click="OnCloseClicked" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Click="OnMinimizeClicked" ToolTip="Minimize">
                        <Path Data="M0,5 L10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Height="10" Width="10" />
                    </Button>
                    <Image Source="Assets/zkidz-dev-logo.png" Width="20" Height="20" Margin="10,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Command and Conquer Zero Hour RoTR Trainer" FontSize="13" Foreground="{StaticResource Quiet}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- State: the one place gold lands -->
            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" ClipToBounds="True">
                <Grid>
                    <!-- The mark's stroke and ring node, at the logo's own 53.4 degree diagonal -->
                    <Canvas Width="200" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Path x:Name="Thread" Data="M160,29 L-3,249" Stroke="{StaticResource Rule}" StrokeThickness="5" />
                        <Ellipse x:Name="Ring" Canvas.Left="145" Canvas.Top="14" Width="30" Height="30" StrokeThickness="8"
                                 Stroke="{StaticResource Rule}" Fill="{StaticResource Raised}" />
                    </Canvas>
                    <StackPanel Margin="24,24,24,22">
                        <TextBlock x:Name="StateWord" Text="DISARMED" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontStretch="Condensed"
                                   FontSize="46" Foreground="{StaticResource Quiet}" LineHeight="44" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Name="StateDetail" FontSize="14" LineHeight="20" Foreground="{StaticResource Quiet}"
                                   TextWrapping="Wrap" Margin="0,9,96,0" />
                        <Button x:Name="ArmButton" Style="{StaticResource ArmButton}" Margin="0,16,0,0" Click="OnArmClicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ArmActionText" Text="Arm" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border Style="{StaticResource KeyCap}"><TextBlock x:Name="ArmKeyText" Text="F5" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live values -->
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="24,12,12,13">
                        <TextBlock Text="Money" FontSize="12" Foreground="{StaticResource Dim}" />
                        <TextBlock x:Name="MoneyText" Text="–" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="18,12,12,13">
                            <TextBlock Text="General's points" FontSize="12" Foreground="{StaticResource Dim}" />
                            <TextBlock x:Name="PointsText" Text="–" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="18,12,12,13">
                            <TextBlock Text="Rank" FontSize="12" Foreground="{StaticResource Dim}" />
                            <TextBlock x:Name="RankText" Text="–" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Features -->
            <ItemsControl x:Name="FeatureList" Margin="0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#99243140" BorderThickness="0,0,0,1" Padding="24,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource KeyCap}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock x:Name="Key" Text="{Binding HotkeyLabel}" Style="{StaticResource KeyText}" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" />
                                        <TextBlock x:Name="Waits" Text="waits for arming" FontSize="12" Foreground="{StaticResource Dim}"
                                                   Margin="7,0,0,1" VerticalAlignment="Bottom" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="Toggle" Grid.Column="3" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsOn, Mode=OneWay}" Click="OnFeatureToggled"
                                              AutomationProperties.Name="{Binding Name}" />
                                <TextBlock x:Name="AlwaysOn" Grid.Column="3" Text="always on" FontSize="12" Foreground="{StaticResource Dim}"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Key" Property="Foreground" Value="{StaticResource SteelStrong}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WaitsForArming}" Value="True">
                                <Setter TargetName="Waits" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Toggle" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlwaysOn}" Value="True">
                                <Setter TargetName="Toggle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="AlwaysOn" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HotkeyUnavailable}" Value="True">
                                <Setter TargetName="Key" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Key" Property="ToolTip" Value="Another program is using this key. The switch still works." />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Owner rules -->
            <TextBlock FontSize="12.5" LineHeight="19" Foreground="{StaticResource Quiet}" TextWrapping="Wrap" Margin="24,10,24,15">
                <Run Text="Single-player only." FontWeight="SemiBold" Foreground="{StaticResource Copy}" />
                <Run Text="Close the trainer and restart the game before LAN or online play, and also if the trainer ever crashes. Do not share replays of trained matches." />
            </TextBlock>

            <!-- Maker and status -->
            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="24,9">
                <DockPanel>
                    <TextBlock x:Name="FooterText" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                    <Image Source="Assets/zkidz-dev-logo.png" Width="18" Height="18" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ZKidz Dev LLC" FontFamily="Georgia" FontSize="13" Foreground="{StaticResource Quiet}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
